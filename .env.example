# PulsePoll Project Configuration Overview
# PulsePoll consists of a Go/Gin backend and a React/Vite frontend.
# Individual configurations reside in backend/.env and frontend/.env.
# See backend/.env.example and frontend/.env.example for comprehensive details.

# Local Development Summary:
# Backend:
#   PORT=8080
#   MONGODB_URI=mongodb://localhost:27017
#   REDIS_URL=redis://localhost:6380
#   JWT_SECRET=pulsepoll-local-dev-jwt-secret-key-2026-safe-for-local-only
#   ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Frontend:
#   VITE_API_BASE_URL=http://localhost:8080
#   VITE_WS_URL=ws://localhost:8080/api

# Production Deployment Summary:
# Backend:
#   PORT=8080
#   ENV=production
#   MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
#   REDIS_URL=rediss://default:<password>@<redis-host>:<port>
#   JWT_SECRET=<cryptographically-random-min-32-chars>
#   ALLOWED_ORIGINS=https://<frontend-domain>
# Frontend:
#   VITE_API_BASE_URL=https://<backend-domain>
#   VITE_WS_URL=wss://<backend-domain>/api
