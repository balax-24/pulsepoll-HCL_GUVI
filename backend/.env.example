# PulsePoll Backend Configuration Example
# Copy this file to .env and adjust values for your environment.

# Server Environment (development | production)
PORT=8080
ENV=development

# MongoDB Connection
# Development (local Docker): mongodb://localhost:27017
# Production (e.g. MongoDB Atlas): mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=pulsepoll

# Redis Connection
# Development (local Docker): redis://localhost:6380
# Production (e.g. Render/Upstash/Redis Cloud): rediss://default:<password>@<host>:<port>
REDIS_URL=redis://localhost:6380

# Authentication / Security
# Replace with a cryptographically secure key in production (min 32 chars: openssl rand -base64 32)
JWT_SECRET=your-256-bit-secret-key-change-in-production-must-be-at-least-32-characters
JWT_EXPIRY_HOURS=72

# CORS Configuration (comma-separated list of allowed frontend origins, NO trailing slash)
# Development: http://localhost:5173,http://127.0.0.1:5173
# Production: https://pulsepoll.onrender.com,https://your-custom-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
