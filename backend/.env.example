# PulsePoll Backend Configuration Example
# Copy this file to .env and adjust values for your environment.

# Server
PORT=8080
ENV=development

# MongoDB Connection
# Local docker-compose runs MongoDB on port 27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=pulsepoll

# Redis Connection
# Local docker-compose maps Redis to host port 6380 to avoid collisions
REDIS_URL=redis://localhost:6380

# Authentication / Security
# Replace with a cryptographically secure key in production (e.g. openssl rand -base64 32)
JWT_SECRET=your-256-bit-secret-key-change-in-production
JWT_EXPIRY_HOURS=72

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
