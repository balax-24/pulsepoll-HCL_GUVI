# PulsePoll Frontend Environment Variables
# Base URL for Go/Gin backend (without trailing slash)
# Development: http://localhost:8080
# Production: https://api.yourdomain.com or https://pulsepoll-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080/api

# WebSocket URL (optional, automatically derived from VITE_API_BASE_URL with wss:// if omitted)
# Development: ws://localhost:8080/api
# Production: wss://api.yourdomain.com/api or wss://pulsepoll-backend.onrender.com/api
VITE_WS_URL=ws://localhost:8080/api
